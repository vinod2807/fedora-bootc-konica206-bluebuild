[Unit]
Description=Torchio per-user print spooler (baked into image)
After=dbus-broker.service

[Service]
Type=simple
Environment=TORCHIO_TRUST_BACKEND=policy
Environment=CUPS_SERVER=%t/torchio/cups.sock
Environment=TORCHIO_CUPS_SOCKET=%t/torchio/cups.sock
ExecStart=/usr/local/bin/torchiod
Restart=on-failure

[Install]
WantedBy=default.target
