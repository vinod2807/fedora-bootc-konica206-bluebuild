# System-wide defaults for the MATE on Xorg session. Compiled by `dconf update`
# at build time. Gives every app (including D-Bus-activated and Flatpak/portal
# ones) dark mode from the first frame, instead of relying on a session
# autostart racing app launch.
[org/mate/interface]
gtk-theme='Adwaita-dark'
icon-theme='Adwaita'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Adwaita'
cursor-theme='Adwaita'
cursor-size=24

# Traditional window controls on the top right of every titlebar.
[org/mate/Marco/general]
button-layout=':minimize,maximize,close'
