# System-wide defaults for the labwc session. Compiled by `dconf update` at build time.
# Gives every app (including D-Bus-activated and Flatpak/portal ones) dark mode from the
# first frame, instead of relying on the session autostart racing app launch.
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
icon-theme='Adwaita'
cursor-theme='Adwaita'
cursor-size=24
