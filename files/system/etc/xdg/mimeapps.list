# System-wide default applications. Browsers/office/media are Flatpaks and register
# themselves when installed, so only the apps shipped in the image are listed here.
[Default Applications]
inode/directory=caja.desktop
application/pdf=atril.desktop
image/jpeg=org.gnome.eog.desktop
image/png=org.gnome.eog.desktop
image/gif=org.gnome.eog.desktop
image/webp=org.gnome.eog.desktop
image/tiff=org.gnome.eog.desktop
image/svg+xml=org.gnome.eog.desktop
text/plain=pluma.desktop
application/zip=engrampa.desktop
application/x-tar=engrampa.desktop
application/gzip=engrampa.desktop
application/x-xz=engrampa.desktop
application/x-7z-compressed=engrampa.desktop
